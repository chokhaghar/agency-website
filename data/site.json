  "faqs": [
    {
      "q": "Footage kaise bhejun?",
      "a": "WhatsApp par seedha bhej do (Document mode mein taaki quality na gire) ya Google Drive link share kar do. Voice-over, logo aur phone number bhi saath bhej dena."
    },
    {
      "q": "Kitne din mein video milega?",
      "a": "Simple reels 24 ghante mein, brand ads 48–72 ghante, 3D walkthrough 72 ghante tak. Express 12-hour delivery add-on se bhi le sakte ho."
    },
    {
      "q": "Rates alag-alag kyun hain?",
      "a": "Jitna zyada editing ka kaam, utna price. 3D tracking, map pins aur voice-over sync mein har frame par kaam hota hai, isliye wo styles mehenge hain. Simple caption reels sabse sasti."
    },
    {
      "q": "Payment kab karni hai?",
      "a": "50% advance par kaam shuru hota hai. Pehle low-quality watermark preview milega, pasand aane par baaki 50% aur final HD file."
    },
    {
      "q": "Kitne changes karwa sakte hain?",
      "a": "Har reel mein 2 revision rounds free hain. Uske baad ₹299 per round."
    },
    {
      "q": "Shooting bhi karte ho?",
      "a": "Hum editing par focus karte hain. Jaipur mein shoot chahiye to WhatsApp par baat karo — partner videographer arrange ho sakta hai."
    },
    {
      "q": "Video kis format mein milega?",
      "a": "1080×1920 vertical (Reels / Shorts / Ads), 60 fps, MP4. 16:9 YouTube version bhi add karwa sakte ho."
    }
  ],
